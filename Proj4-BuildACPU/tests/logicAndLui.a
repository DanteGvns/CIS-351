# Logical immediates intentionally stay below 0x8000.
.text
lui  $2, 0xAAAA
ori  $2, $2, 0x5555
lui  $3, 0x5555
ori  $3, $3, 0x2AAA
and  $4, $2, $3         # 0
or   $5, $2, $3         # 0xFFFF7FFF
nor  $6, $2, $3         # 0x00008000
and  $7, $2, $2         # 0xAAAA5555
or   $8, $2, $0         # 0xAAAA5555
nor  $9, $0, $0         # 0xFFFFFFFF
and  $10, $2, $9        # 0xAAAA5555
or   $11, $3, $9        # 0xFFFFFFFF
nor  $12, $2, $0        # 0x5555AAAA
andi $13, $2, 0x7FFF    # 0x5555; upper half must clear
ori  $14, $3, 0x5555    # 0x55557FFF
andi $15, $9, 0         # 0
ori  $16, $2, 0         # unchanged
andi $17, $9, 0x7FFF    # 32767
ori  $18, $0, 0x4000
lui  $18, 0x1234        # must replace old low bits with zero
lui  $19, 0x8000
lui  $20, 0xFFFF
lui  $21, 0
addi $22, $0, -1
lui  $22, 0x00AB        # 0x00AB0000, not OR with old contents
and  $23, $12, $3
or   $24, $13, $18
nor  $25, $24, $19
andi $26, $25, 0x1234
ori  $27, $26, 0x2345
and  $28, $27, $9
